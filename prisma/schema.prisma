generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["risk_score_model"]
}
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
  @@schema("risk_score_model")
}

model shopify_store_order {
  id                String   @id @default(cuid())
  shop              String
  shopifyOrderId    String
  
  customerId        String?
  firstName         String?
  lastName          String?
  customerEmail     String?
  customerPhone     String?
  lineItemsData     String?   @db.Text 

  orderValue        Decimal  @db.Decimal(10,2)

  paymentGateway    String?
  financialStatus   String?
  fulfillmentStatus String?

  carrier           String?
  trackingNumber    String?
  trackingUrl       String?
  shipmentStatus    String?

  ipAddress         String?
  shippingAddress1  String?
  shippingAddress2  String?
  shippingCity      String?
  shippingProvince  String?
  shippingZip       String?
  shippingCountry   String?
  billingAddress1   String?
  billingAddress2   String?
  billingCity       String?
  billingProvince   String?
  billingZip        String?
  billingCountry    String?
  addressVerified  Boolean @default(false)
  addressFingerprint String? // Used to detect if the address changed
  hasDispute        Boolean  @default(false)
  isRTO             Boolean  @default(false)

  cancelledAt       DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  riskScore         zippyy_risk_score?
  // RELATIONS to dispute table 
  disputes          shopify_dispute[]
  //  foreign key to the Buyer Profile
  buyerProfileId    String?
  buyerProfile      zippyy_buyer_profile? @relation(fields: [buyerProfileId], references: [id], onDelete: SetNull)

  // INDEXES
  @@unique([shop, shopifyOrderId])
  @@index([shop, customerEmail])
  @@index([shop, customerId])
  @@index([shop, customerPhone]) 
  @@index([shop, createdAt])
  @@index([shop, buyerProfileId]) 

  @@schema("risk_score_model")
}

model zippyy_risk_score {
  id        String   @id @default(cuid())
  shop      String

  orderId   String   @unique
  order     shopify_store_order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  score     Int
  riskLevel RiskLevel
  reasons   String

  createdAt DateTime @default(now())

  @@index([shop, orderId])

  @@schema("risk_score_model")
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  @@schema("risk_score_model")
}

model zippyy_buyer_profile {
  id                    String   @id @default(uuid())
  shop                  String
  buyerIdentifier       String   // e.g., "customer_12345" or "email_john@test.com"
  firstName             String?
  lastName              String?
  customerEmail         String? 
  customerId            String?  
  customerPhone         String?
  shippingAddress1    String?
  shippingCountry     String?
  billingCountry      String?
  // Aggregate Stats
  totalorders Int      @default(0)
  validOrderCount       Int      @default(0)
  totalSpend            Float    @default(0)
  fulfilledCount        Int      @default(0)
  cancelledCount        Int      @default(0)
  rtoCount              Int      @default(0)
  codCount              Int      @default(0)
  unpaidCount           Int      @default(0)
   
  // NEW: Granular Dispute Stats for the Risk Engine
  disputeCount          Int      @default(0)
  refundCount           Int      @default(0)
  fraudDisputeCount Int      @default(0) // Disputes categorized specifically as 'fraudulent'
  lostDisputeCount  Int      @default(0) // Disputes where the merchant lost the money
  wonDisputeCount   Int      @default(0) // Disputes where the merchant won the case
  // Computed Risk Data
  buyerSegment          String   @default("New") // VIP, Repeat Buyer, New, High Risk
  riskReasons           String?  

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // RELATIONS
  orders                shopify_store_order[]

  // CONSTRAINTS & INDEXES
  @@unique([shop, buyerIdentifier]) // Ensures only ONE profile per identifier, per shop
  @@index([shop]) 
  @@index([shop, buyerSegment]) // Makes clicking "VIP" or "High Risk" tabs load instantly
  @@index([shop, totalorders(sort: Desc)]) // Makes pagination sorting instant
  @@index([shop, customerEmail]) // Speeds up search logic
  @@index([shop, customerPhone]) // Speeds up search logic

  @@schema("risk_score_model")
}

model merchant_feedback {
  id        String   @id @default(cuid())
  shop      String
  message   String   @db.Text
  status    String   @default("UNREAD") 
  createdAt DateTime @default(now())

  @@index([shop])
  @@index([createdAt])
  @@schema("risk_score_model")
}

// Add this model to your schema.prisma
model zippyy_risk_settings {
  id                    String   @id @default(uuid())
  shop                  String   @unique
  guestCodPenalty       Int      @default(15)
  shortNamePenalty      Int      @default(20)
  missingAddressPenalty Int      @default(30)
  missingHouseNoPenalty Int      @default(15)
  cancelWeight          Int      @default(35)
  disputeWeight         Int      @default(50)
  rtoWeight             Int      @default(35)
  abandonWeight         Int      @default(25)
  zeroValuePenalty      Int      @default(25)
  refundWeight          Int      @default(25)
  pendingPaymentPenalty Int      @default(20)
  codAbuseWeight        Int      @default(20)
  valueAnomalyPenalty   Int      @default(15)
  loyaltyBonus          Int      @default(5)
  addressFraudPenalty   Int      @default(30)
  phoneFraudPenalty     Int      @default(30)
  hoardingHighPenalty   Int      @default(30)
  hoardingMedPenalty    Int      @default(15)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  openDisputePenalty    Int      @default(40)  // Penalty if they try to buy while a dispute is pending
  fraudHistoryPenalty   Int      @default(100) // Immediate rejection if past 'fraudulent' reason code exists
  @@schema("risk_score_model")
}

model India_valid_pincodes {
  id          String   @id @default(cuid())
  countryCode String   @default("IN")
  postalCode  String   @unique // The 6-digit PIN
  placeName   String?  // e.g., "Mangalhat"
  state       String?  // e.g., "Telangana"
  district    String?  // e.g., "Hyderabad"

  @@index([postalCode]) // Crucial for 0-latency lookups
  @@schema("risk_score_model")
}

model shopify_dispute {
  id                  String   @id @default(cuid())
  shop                String
  shopifyDisputeId    String   // The ID provided by Shopify's webhook
  
  orderId             String
  order               shopify_store_order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status              String   // e.g., 'needs_response', 'under_review', 'charge_refunded', 'won', 'lost'
  reason              String   // e.g., 'fraudulent', 'product_not_received', 'product_unacceptable', 'unrecognized'
  
  amount              Decimal  @db.Decimal(10,2)
  currency            String   @default("USD")
  
  evidenceDueBy       DateTime? // Crucial for dashboard alerts
  hasSubmittedEvidence Boolean  @default(false)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([shop, shopifyDisputeId])
  @@index([shop, orderId])
  @@index([shop, status]) // Speeds up dashboard queries for "Action Required" disputes
  @@schema("risk_score_model")
}























