generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["risk_score_model"]
}
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
  @@schema("risk_score_model")
}
model shopify_store_order {
  id                String   @id @default(cuid())
  shop              String
  shopifyOrderId    String

  customerId        String?
  customerEmail     String?
  customerPhone     String?

  orderValue        Decimal  @db.Decimal(10,2)

  paymentGateway    String?
  financialStatus   String?
  fulfillmentStatus String?

  ipAddress         String?
  shippingAddress1  String?
  shippingCountry   String?
  billingCountry    String?

  hasDispute        Boolean  @default(false)
  isRTO             Boolean  @default(false)

  cancelledAt       DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  riskScore         zippyy_risk_score?

  @@unique([shop, shopifyOrderId])
  @@index([shop, customerEmail])
  @@index([shop, customerId])
  @@index([shop, createdAt])

  @@schema("risk_score_model")
}
model zippyy_risk_score {
  id          String   @id @default(cuid())
  shop        String

  orderId     String   @unique
  order       shopify_store_order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  score       Int
  riskLevel   RiskLevel
  reasons     String

  createdAt   DateTime @default(now())

  @@index([shop, orderId])

  @@schema("risk_score_model")
}
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  @@schema("risk_score_model")
}
model zippyy_buyer_profile {
  id                    String   @id @default(uuid())
  shop                  String
  buyerIdentifier       String   // The Fallback ID (Phone > Email > CustID > OrderID)
  customerEmail         String? 
  customerId            String?  
  customerPhone         String?

  // Aggregate Stats
  totalCheckoutAttempts Int      @default(0)
  validOrderCount       Int      @default(0)
  totalSpend            Float    @default(0)
  fulfilledCount        Int      @default(0)
  cancelledCount        Int      @default(0)
  rtoCount              Int      @default(0)
  codCount              Int      @default(0)
  unpaidCount           Int      @default(0)
  disputeCount          Int      @default(0)
  refundCount           Int      @default(0)

  // Computed Risk Data
  buyerSegment          String   @default("New") // VIP, Repeat Buyer, New, High Risk
  riskReasons           String?  

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // This ensures we only ever have ONE profile per email, per shop
  @@unique([shop, buyerIdentifier])
  @@schema("risk_score_model")
}
// --------------------------------------------------
// 4. WEBHOOK IDEMPOTENCY
// --------------------------------------------------
model store_completed_order {
  id          String   @id @default(cuid()) // Updated to cuid()
  shop        String
  orderId     String
  customerId  String?  // Made nullable to match StoreOrder guest checkouts
  orderValue  Float
  
  createdAt   DateTime @default(now())

  @@unique([shop, orderId], name: "shop_orderId")
  @@schema("risk_score_model")
}

